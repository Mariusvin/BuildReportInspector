.tab {
    border-width: 1px;
    border-color: black;
    padding: 5px;
    margin: 2px;
}

.tab:checked {
    background-color: #555;
}

.tab-content-panel {
    flex-grow: 1;
    padding: 10px;
}

#search-field {
    flex-grow: 1;
}

#file-list .unity-list-view__header {
    background-color: #333;
}

#file-list .unity-list-view__header-label {
    font-weight: bold;
}
